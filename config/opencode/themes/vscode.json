{
  "$schema": "https://opencode.ai/theme.json",
  "defs": {
    "darkBg": "#1F1F1F",
    "darkPanel": "#252526",
    "darkElement": "#2D2D2D",
    "darkBorder": "#444444",
    "darkText": "#D4D4D4",
    "darkMuted": "#808080",
    "darkBlue": "#569CD6",
    "darkAccentBlue": "#4FC1FF",
    "darkLightBlue": "#9CDCFE",
    "darkGreen": "#6A9955",
    "darkRed": "#F44747",
    "darkYellow": "#DCDCAA",
    "darkOrange": "#CE9178",
    "darkPink": "#C586C0",
    "darkTeal": "#4EC9B0",
    "lightBg": "#FFFFFF",
    "lightPanel": "#F3F3F3",
    "lightElement": "#E8E8E8",
    "lightBorder": "#DDDDDD",
    "lightText": "#343434",
    "lightMuted": "#767676",
    "lightBlue": "#0451A5",
    "lightAccentBlue": "#007ACC",
    "lightGreen": "#008000",
    "lightRed": "#A31515",
    "lightYellow": "#795E26",
    "lightOrange": "#C72E0F",
    "lightPink": "#AF00DB",
    "lightTeal": "#16825D"
  },
  "theme": {
    "primary": { "dark": "darkBlue", "light": "lightAccentBlue" },
    "secondary": { "dark": "darkPink", "light": "lightPink" },
    "accent": { "dark": "darkTeal", "light": "lightTeal" },
    "error": { "dark": "darkRed", "light": "lightRed" },
    "warning": { "dark": "darkOrange", "light": "lightOrange" },
    "success": { "dark": "darkGreen", "light": "lightGreen" },
    "info": { "dark": "darkAccentBlue", "light": "lightBlue" },
    "text": { "dark": "darkText", "light": "lightText" },
    "textMuted": { "dark": "darkMuted", "light": "lightMuted" },
    "background": { "dark": "darkBg", "light": "lightBg" },
    "backgroundPanel": { "dark": "darkPanel", "light": "lightPanel" },
    "backgroundElement": { "dark": "darkElement", "light": "lightElement" },
    "border": { "dark": "darkBorder", "light": "lightBorder" },
    "borderActive": { "dark": "darkBlue", "light": "lightAccentBlue" },
    "borderSubtle": { "dark": "darkPanel", "light": "lightPanel" },
    "diffAdded": { "dark": "darkGreen", "light": "lightGreen" },
    "diffRemoved": { "dark": "darkRed", "light": "lightRed" },
    "diffContext": { "dark": "darkMuted", "light": "lightMuted" },
    "diffHunkHeader": { "dark": "darkBlue", "light": "lightBlue" },
    "diffHighlightAdded": { "dark": "darkGreen", "light": "lightGreen" },
    "diffHighlightRemoved": { "dark": "darkRed", "light": "lightRed" },
    "diffAddedBg": { "dark": "#373D29", "light": "#DBE6C2" },
    "diffRemovedBg": { "dark": "#4B1818", "light": "#FFCCCC" },
    "diffContextBg": { "dark": "darkPanel", "light": "lightPanel" },
    "diffLineNumber": { "dark": "darkMuted", "light": "lightMuted" },
    "diffAddedLineNumberBg": { "dark": "#4B5632", "light": "#EBF1DD" },
    "diffRemovedLineNumberBg": { "dark": "#6F1313", "light": "#FFA3A3" },
    "markdownText": { "dark": "darkText", "light": "lightText" },
    "markdownHeading": { "dark": "darkYellow", "light": "lightYellow" },
    "markdownLink": { "dark": "darkBlue", "light": "lightBlue" },
    "markdownLinkText": { "dark": "darkAccentBlue", "light": "lightAccentBlue" },
    "markdownCode": { "dark": "darkOrange", "light": "lightRed" },
    "markdownBlockQuote": { "dark": "darkMuted", "light": "lightMuted" },
    "markdownEmph": { "dark": "darkOrange", "light": "lightOrange" },
    "markdownStrong": { "dark": "darkYellow", "light": "lightYellow" },
    "markdownHorizontalRule": { "dark": "darkMuted", "light": "lightMuted" },
    "markdownListItem": { "dark": "darkTeal", "light": "lightTeal" },
    "markdownListEnumeration": { "dark": "darkAccentBlue", "light": "lightAccentBlue" },
    "markdownImage": { "dark": "darkPink", "light": "lightPink" },
    "markdownImageText": { "dark": "darkTeal", "light": "lightTeal" },
    "markdownCodeBlock": { "dark": "darkText", "light": "lightText" },
    "syntaxComment": { "dark": "darkGreen", "light": "lightGreen" },
    "syntaxKeyword": { "dark": "darkPink", "light": "lightPink" },
    "syntaxFunction": { "dark": "darkYellow", "light": "lightYellow" },
    "syntaxVariable": { "dark": "darkLightBlue", "light": "lightBlue" },
    "syntaxString": { "dark": "darkOrange", "light": "lightRed" },
    "syntaxNumber": { "dark": "#B5CEA8", "light": "#098658" },
    "syntaxType": { "dark": "darkBlue", "light": "#0000FF" },
    "syntaxOperator": { "dark": "darkText", "light": "#000000" },
    "syntaxPunctuation": { "dark": "darkText", "light": "#000000" }
  }
}
