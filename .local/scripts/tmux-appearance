#!/usr/bin/env bash
# Detects the system appearance and sets the tmux status bar background.
# macOS reads AppleInterfaceStyle, WSL reads the Windows app theme, and native
# Linux asks GNOME if it is present.
# Anything undetectable falls back to dark rather than flashing a light bar
# on a dark terminal.

appearance=""

if [ "$(uname)" = "Darwin" ]; then
    if defaults read -g AppleInterfaceStyle 2>/dev/null | grep -qi dark; then
        appearance="Dark"
    else
        appearance="Light"
    fi
elif [ -n "${WSL_INTEROP:-}" ] && command -v powershell.exe >/dev/null 2>&1; then
    windows_light=$(powershell.exe -NoProfile -Command \
        "(Get-ItemProperty -Path 'HKCU:\Software\Microsoft\Windows\CurrentVersion\Themes\Personalize').AppsUseLightTheme" \
        2>/dev/null | tr -d '[:space:]')
    case "$windows_light" in
        1) appearance="Light" ;;
        0) appearance="Dark" ;;
    esac
elif command -v gsettings >/dev/null 2>&1; then
    case "$(gsettings get org.gnome.desktop.interface color-scheme 2>/dev/null)" in
        *prefer-light*|*default*) appearance="Light" ;;
        *prefer-dark*)           appearance="Dark" ;;
    esac
fi

if [ "$appearance" = "Light" ]; then
    tmux set -g status-style "bg=#FFFFFF"
else
    tmux set -g status-style "bg=#1F1F1F"
fi
