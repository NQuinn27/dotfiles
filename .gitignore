.DS_Store
.env

.sessionizer-projects
.chtsh-languages
.chtsh-utils

lazy-lock.json
.envrc
backups/

.agents/skills/ui/

# Python
__pycache__/
*.pyc

# Plannotator runtime/state (keep config tracked)
.plannotator/*
!.plannotator/config.json

# herdr runtime/state. ~/.config/herdr symlinks into this checkout, so herdr
# writes logs, sockets and session state (which pane_history may fill with
# secrets) straight into the repo. Allowlist, not denylist: anything new herdr
# starts writing must stay out of git by default.
config/herdr/*
!config/herdr/config.toml

# tmux plugins are installed by tpm at runtime, not tracked here.
config/tmux/plugins/*
!config/tmux/plugins/.gitkeep

# Alternate nvim config; a LazyVim starter clone, not tracked here.
config/nvim-lazy/

# Editor / tool runtime noise (leaks local paths, usernames, kernel versions)
*.log
.nvimlog
.write_probe_*

# Pi is symlinked from ~/.pi into this checkout. Keep the tree deny-by-default:
# only reviewed, portable configuration and source directories are allowlisted.
.pi/*
!.pi/.gitignore
!.pi/agent/
.pi/agent/*

!.pi/agent/AGENTS.md
!.pi/agent/cloak.json
!.pi/agent/mcp.json
!.pi/agent/settings.json

!.pi/agent/themes/
.pi/agent/themes/*
!.pi/agent/themes/*.json

!.pi/agent/extensions/
.pi/agent/extensions/*
!.pi/agent/extensions/auto-session-name.ts
!.pi/agent/extensions/continue-after-compaction.ts
!.pi/agent/extensions/effort.ts
!.pi/agent/extensions/file-search.ts
!.pi/agent/extensions/git-interceptor.ts
!.pi/agent/extensions/herdr-agent-state.ts
!.pi/agent/extensions/package-lock.json
!.pi/agent/extensions/package.json
!.pi/agent/extensions/tsconfig.selected.json
!.pi/agent/extensions/whimsical.ts
!.pi/agent/extensions/background-terminals/
!.pi/agent/extensions/background-terminals/**
!.pi/agent/extensions/copy-all/
!.pi/agent/extensions/copy-all/**
!.pi/agent/extensions/git-info/
!.pi/agent/extensions/git-info/**
!.pi/agent/extensions/model-info/
!.pi/agent/extensions/model-info/**
!.pi/agent/extensions/pi-cloak/
!.pi/agent/extensions/pi-cloak/**
!.pi/agent/extensions/save-md/
!.pi/agent/extensions/save-md/**
!.pi/agent/extensions/shared/
!.pi/agent/extensions/shared/**
!.pi/agent/extensions/subagents/
!.pi/agent/extensions/subagents/**
!.pi/agent/extensions/summaries/
!.pi/agent/extensions/summaries/**
!.pi/agent/extensions/tests/
!.pi/agent/extensions/tests/**
!.pi/agent/extensions/ui-customization/
!.pi/agent/extensions/ui-customization/**

!.pi/agent/skills/
.pi/agent/skills/*
!.pi/agent/skills/background-terminals/
!.pi/agent/skills/background-terminals/**
!.pi/agent/skills/herdr/
!.pi/agent/skills/herdr/**
!.pi/agent/skills/subagents/
!.pi/agent/skills/subagents/**

# Final safety layer. These rules deliberately come after every allowlist so a
# broad source exception can never re-include credentials or generated state.
.pi/agent/auth.json
.pi/agent/auth.json.lock
.pi/agent/bin/
.pi/agent/models-store.json
.pi/agent/npm/
.pi/agent/sessions/
.pi/agent/state/
.pi/agent/trust.json
.pi/agent/mcp-auth.json
.pi/agent/mcp-cache.json
.pi/agent/mcp-npx-cache.json
.pi/agent/mcp-oauth/
.pi/agent/extensions/.pi-subagents/
.pi/agent/**/node_modules/
.pi/agent/**/.env
.pi/agent/**/.env.*
.pi/agent/**/.envrc
.pi/agent/**/*.pem
.pi/agent/**/*.key
.pi/agent/**/id_rsa*
.pi/agent/**/*credential*
.pi/agent/**/*secret*
.pi/agent/**/.netrc
.pi/agent/**/.npmrc
.pi/backups/
.pi/todos/
.pi/.pi/
.local/share/pi/mcp-auth.json
